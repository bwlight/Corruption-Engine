{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Entity",
  "type": "object",
  "required": ["id", "name", "stats"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "stats": {
      "type": "object",
      "required": ["hp", "atk", "def"],
      "properties": {
        "hp": { "type": "integer", "minimum": 0 },
        "atk": { "type": "integer", "minimum": 0 },
        "def": { "type": "integer", "minimum": 0 }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}