{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quest",
  "type": "object",
  "required": ["id", "title", "steps"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "next"],
              "properties": {
                "text": { "type": "string" },
                "next": { "type": "string" },
                "requirements": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "effects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "corruption": { "type": "integer" },
                      "flag": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "rewards": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}